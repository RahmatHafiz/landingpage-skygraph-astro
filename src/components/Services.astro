<section
        id="layanan"
        class="py-16 md:py-24 bg-slate-50 border-b border-slate-200"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16 reveal">
                <span
                    class="text-brand-600 font-bold tracking-widest uppercase text-xs mb-2 block"
                    >Spesialisasi Kami</span
                >
                <h2
                    class="text-3xl md:text-4xl font-display font-bold text-slate-900"
                >
                    Cakupan Jasa Drone.
                </h2>
            </div>

            <div
                class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4"
            >
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal group hover:border-brand-500"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >

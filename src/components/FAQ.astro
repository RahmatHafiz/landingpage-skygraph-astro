---
import faqData from '../data/faq.json';

const ldJson = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
        }
    }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(ldJson)}></script>

<section
    id="faq"
    class="py-16 md:py-24 bg-slate-900 border-b border-slate-800"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 reveal">
            <span
                class="text-brand-400 font-bold tracking-widest uppercase text-xs mb-2 block"
                >Pusat Bantuan</span
            >
            <h2
                class="text-3xl md:text-4xl font-display font-bold text-white"
            >
                FAQ & Tanya Jawab.
            </h2>
            <p class="mt-3 text-slate-600 text-sm">
                Menjawab keraguan Anda sebelum menggunakan jasa kami.
            </p>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-4 reveal delay-100 items-start"
        >
            {faqData.map((faq, index) => (
                <div
                    class="faq-item flex flex-col bg-slate-800 border border-slate-700 rounded-2xl transition-all duration-300 hover:border-brand-500 hover:shadow-md shadow-sm group"
                >
                    <button
                        type="button"
                        class="w-full px-5 py-5 text-left flex justify-between items-center font-bold text-[14px] md:text-[15px] text-white group-hover:text-brand-400 focus:outline-none"
                        onclick="toggleFaq(this)"
                    >
                        {faq.question}
                        <svg
                            aria-hidden="true"
                            class="w-5 h-5 text-slate-600 group-hover:text-brand-500 faq-icon shrink-0 transition-transform duration-300 ml-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 6v12m-6-6h12"></path>
                        </svg>
                    </button>
                    <div class="faq-answer px-5">
                        <p
                            class="pb-5 text-[14px] text-slate-300 border-t border-slate-700 pt-4 leading-relaxed"
                            set:html={faq.answer}
                        >
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
    window.toggleFaq = function (button) {
        if (!button || !button.parentElement) return;
        const faqItem = button.parentElement;
        document.querySelectorAll('.faq-item').forEach(item => {
            if (item !== faqItem) item.classList.remove('active');
        });
        const isActive = faqItem.classList.toggle('active');
        button.setAttribute('aria-expanded', isActive);
    };
    });
</script>

                    alt="Brio Pekanbaru"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/taf-unand.webp"
                    alt="TAF Unand"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24 bg-slate-50 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16 reveal">
                <span
                    class="text-brand-600 font-bold tracking-widest uppercase text-xs mb-2 block"
                    >Standar Operasional</span
                >
                <h2
                    class="text-3xl md:text-4xl font-display font-bold text-slate-900"
                >
                    Nilai Lebih Kami.
                </h2>
            </div>

            <div
                class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6"
            >
                <!-- Card 1 -->
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal hover:-translate-y-2 group hover:border-brand-500 transition-all"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                            >
                            </path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-bold mb-2 text-slate-900">
                        Layanan Terpadu
                    </h4>
                    <p class="text-slate-600 text-sm">
                        Kami menangani seluruh proses penuh, mulai dari
                        perizinan hingga pasca-produksi.
                    </p>
                </div>
                <!-- Card 2 -->
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal delay-100 hover:-translate-y-2 group hover:border-brand-500 transition-all"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                            >
                            </path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-bold mb-2 text-slate-900">
                        Armada Spesifik
                    </h4>
                    <p class="text-slate-600 text-sm">
                        Armada optimal untuk segala medan, dari unit mini indoor
                        hingga drone untuk kegiatan outdoor.
                    </p>
                </div>
                <!-- Card 3 -->
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal delay-200 hover:-translate-y-2 group hover:border-brand-500 transition-all"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                            >
                            </path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-bold mb-2 text-slate-900">
                        Seni Visual Estetik
                    </h4>
                    <p class="text-slate-600 text-sm">
                        Pilot komersial dengan insting sinematik tinggi untuk
                        hasil visual yang dramatis.
                    </p>
                </div>
                <!-- Card 4 -->
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal hover:-translate-y-2 group hover:border-brand-500 transition-all"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-bold mb-2 text-slate-900">
                        Efisiensi Waktu
                    </h4>
                    <p class="text-slate-600 text-sm">
                        Akuisisi lahan luas dan dokumentasi selesai tepat waktu
                        dengan workflow terukur.
                    </p>
                </div>
                <!-- Card 5 -->
                <div
                    class="bento-card bg-white border border-slate-200 p-6 reveal delay-100 hover:-translate-y-2 group hover:border-brand-500 transition-all"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7l6-3 5.447 2.724A1 1 0 0121 7.618v10.764a1 1 0 01-1.447.894L15 17l-6 3z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 7v10M15 7v10"
                            >
                            </path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-bold mb-2 text-slate-900">
                        Akurasi & Presisi
                    </h4>

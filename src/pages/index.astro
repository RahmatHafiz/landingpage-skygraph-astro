---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <Fragment slot="head">
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ProfessionalService",
                "@id": "https://skygraph.id/#business",
                "name": "SKYGRAPH Aerial Solutions",
                "alternateName": "Skygraph",
                "logo": "https://skygraph.id/assets/favicon.svg",
                "description": "Layanan jasa drone profesional, pemetaan topografi, videografi udara 4K, inspeksi aset, dan penyewaan unit drone di Pekanbaru, Riau.",
                "url": "https://skygraph.id",
                "telephone": "+6281234567890",
                "email": "skygraph.idn@gmail.com",
                "priceRange": "",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Pekanbaru",
                    "addressRegion": "Riau",
                    "addressCountry": "ID"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": "0.507068",
                    "longitude": "101.447779"
                },
                "areaServed": {
                    "@type": "State",
                    "name": "Riau",
                    "containedInPlace": {
                        "@type": "Country",
                        "name": "Indonesia"
                    }
                },
                "openingHoursSpecification": {
                    "@type": "OpeningHoursSpecification",
                    "dayOfWeek": [
                        "Monday",
                        "Tuesday",
                        "Wednesday",
                        "Thursday",
                        "Friday",
                        "Saturday"
                    ],
                    "opens": "08:00",
                    "closes": "18:00"
                },
                "sameAs": ["https://instagram.com/skygraph.id"],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Layanan Drone Profesional",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Fotografi & Videografi Udara 4K",
                                "description": "Produksi visual cinematic 4K HDR untuk profil perusahaan, iklan, dan sosial media."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Dokumentasi Event & Wedding",
                                "description": "Liputan konser, festival, pernikahan, atau kegiatan massal outdoor secara dramatis dari udara."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Pemetaan & Topografi Drone",
                                "description": "Peta Orthomosaic, Topografi, Kontur, dan perhitungan volume Cut & Fill presisi tinggi."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Inspeksi Aset",
                                "description": "Pengecekan area sempit, atap pabrik, jembatan, tower, tanpa resiko keselamatan."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Sewa Unit Drone",
                                "description": "Penyewaan armada drone tanpa pilot untuk kebutuhan personal atau harian."
                            }
                        }
                    ]
                }
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "Apakah saya perlu mengurus izin terbang (clearance)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Tidak perlu. Anda cukup terima beres. Segala perizinan operasional (SIDOPI, AirNav) akan kami tangani sepenuhnya sebelum eksekusi, terutama untuk penerbangan di area Red Zone atau objek vital."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana jika cuaca buruk pada hari eksekusi?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami menerapkan protokol Zero Accident. Jika cuaca ekstrem (hujan/angin kencang), pilot berhak menunda operasi demi keselamatan. Kami menjamin Reschedule tanpa biaya tambahan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah drone aman diterbangkan di dalam ruangan (Indoor)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Sangat aman. Untuk kebutuhan indoor, kami menggunakan armada spesifik Potensic Atom (ringan, stabil, dan manuver gesit) atau armada khusus indoor lainnya sehingga terhindar dari risiko besar."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apa solusi jika drone terkendala teknis di tengah proyek?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami selalu mencegah downtime. Tim di lapangan diwajibkan selalu membawa Backup Unit (drone cadangan). Alur kerja proyek Anda tidak akan terhenti hanya karena kendala pada satu alat."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah data rahasia proyek perusahaan dijamin aman?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Terjamin 100%. Kami siap menandatangani kontrak NDA (Non-Disclosure Agreement). Seluruh data mentah (raw) akan dihapus secara permanen dari server kami segera setelah proyek selesai diserahterimakan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana jika proyek berada di luar kota Pekanbaru?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Sangat bisa. Biaya transportasi dan akomodasi tim akan ditambahkan secara transparan (at cost) ke dalam invoice, atau bisa diakomodasi langsung oleh pihak klien sesuai kesepakatan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Berapa lama estimasi proses pengerjaan (Delivery)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Estimasi sangat bergantung pada volume pekerjaan. Untuk editing video event biasanya memakan waktu 1-3 hari kerja. Sementara proses render pemetaan topografi/3D skala besar membutuhkan waktu 3-5 hari kerja."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Format hasil akhir apa yang akan saya terima?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Video & Foto: Format MP4/MOV beresolusi tinggi (hingga 4K) dan JPG/RAW. Data Geospasial: GeoTIFF (Orthomosaic, DEM), format DWG/DXF untuk kebutuhan AutoCAD, serta dokumen Laporan dalam bentuk PDF."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah ada batasan untuk revisi hasil editing?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami memberikan 2x kuota revisi minor secara gratis (seperti pergantian lagu pengiring atau pemotongan durasi). Untuk revisi mayor yang merubah struktur keseluruhan secara signifikan, akan dikenakan biaya tambahan ringan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana sistem pembayarannya?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Reguler: Pembayaran DP sebesar 50% untuk booking jadwal operasional, dan sisa 50% pelunasan diselesaikan sebelum penyerahan file master. Untuk paket korporat (B2B), sistem Term of Payment (TOP) dapat dinegosiasikan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah ada batasan durasi untuk sewa unit drone?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Minimal waktu penyewaan adalah 1 hari penuh (24 jam). Untuk masa penyewaan lebih dari 3 hari berturut-turut, kami secara otomatis akan memberikan potongan harga khusus (corporate rate)."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apa syarat utama untuk proses sewa unit drone?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Syarat utamanya sangat mudah: Penyewa wajib menitipkan 2 (dua) ID Card Asli (E-KTP & SIM/Paspor), menyertakan Deposit Tunai sebagai jaminan awal (akan dikembalikan 100% jika unit aman), serta menandatangani formulir kesepakatan sewa saat serah terima unit."
                        }
                    }
                ]
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Beranda",
                        "item": "https://skygraph.id/"
                    }
                ]
            }
        </script>
        <link
            rel="preload"
            as="image"
            href="/assets/homepage-vid/tugu-songket-poster.jpg"
            fetchpriority="high"
        />
    </Fragment>
    <section
        class="relative pt-32 pb-20 md:pt-40 md:pb-32 overflow-hidden bg-slate-900 min-h-screen flex items-center"
        id="hero"
    >
        <div class="video-bg-container">
            <video
                id="hero-video-1"
                src="/assets/homepage-vid/tugu-songket.webm"
                poster="/assets/homepage-vid/tugu-songket-poster.jpg"
                autoplay
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover opacity-60 transition-opacity duration-1000"
            >
            </video>
            <video
                id="hero-video-2"
                src=""
                autoplay
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
            >
            </video>
        </div>
        <!-- Dark gradient overlay for text readability -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent pointer-events-none"
        >
        </div>

        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center w-full flex flex-col items-center justify-center"
        >
            <!-- Top Text -->
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-500/20 backdrop-blur border border-brand-500/30 text-brand-300 font-semibold text-xs md:text-sm shadow-sm reveal"
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"
                    ></span>
                </span>
                SKYGRAPH
            </div>

            <h1
                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-display font-extrabold leading-[1.3] sm:leading-[1.2] tracking-tight text-white reveal delay-100 max-w-4xl mx-auto my-24 sm:my-28 md:my-32 lg:my-40 px-2 sm:px-0 flex flex-col items-center"
            >
                <span>Jasa Drone Profesional</span>
                <span
                    class="dynamic-text mt-2 block h-[3em] sm:h-[2.4em] md:h-[1.2em] w-full"
                ></span>
            </h1>

            <!-- Bottom Buttons -->
            <div
                class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 justify-center reveal delay-200"
            >
                <a
                    href="#kontak"
                    class="inline-block px-7 py-3.5 sm:px-8 sm:py-4 rounded-xl bg-brand-500 text-white font-bold text-center hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 focus:ring-offset-slate-900 shadow-lg shadow-brand-500/30 transition-all duration-300 transform hover:-translate-y-1"
                >
                    Konsultasi Gratis
                </a>
                <a
                    href="#layanan"
                    class="inline-block px-7 py-3.5 sm:px-8 sm:py-4 rounded-xl bg-white/10 text-white backdrop-blur border border-white/20 font-bold text-center hover:bg-white hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-900 transition-all duration-300 shadow-sm transform hover:-translate-y-1"
                >
                    Jelajahi Layanan
                </a>
            </div>
        </div>
    </section>

    <section
        class="py-5 md:py-8 border-b border-slate-200 bg-white overflow-hidden flex relative z-10"
        aria-label="Klien industri kami"
        role="marquee"
    >
        <div
            class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"
        >
        </div>
        <div
            class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"
        >
        </div>

        <div
            class="flex whitespace-nowrap items-center w-full relative"
            id="client-marquee"
        >
            <div
                class="flex items-center shrink-0 gap-12 sm:gap-20 md:gap-32 pr-12 sm:pr-20 md:pr-32 animate-marquee"
                style="will-change: transform;"
            >
                <img
                    src="/assets/logo/es-cokelat-mas-lino.webp"
                    alt="Es Cokelat Mas Lino"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/himatif.webp"
                    alt="Himatif"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/honda-bikersday.webp"
                    alt="Honda Bikers Day"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/ikatan-putera-pekanbaru.webp"
                    alt="Ikatan Putera Pekanbaru"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/kavling-madani.webp"
                    alt="Kavling Madani"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/pa-ali.webp"
                    alt="PA Ali"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/riuh-run.webp"
                    alt="Riuh Run"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/runesthesia.webp"
                    alt="Runesthesia"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/smks-pro-skill.webp"
                    alt="SMKS Pro Skill"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/afifah-ansari-maju.webp"
                    alt="Afifah Ansari Maju"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img
                    src="/assets/logo/bapow.webp"
                    alt="Bapow"
                    loading="lazy"
                    width="200"
                    height="100"
                    class="h-12 sm:h-16 md:h-20 w-auto object-contain shrink-0 transition-all duration-300"
                />
                <img

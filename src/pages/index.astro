---
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import About from "../components/About.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Services from "../components/Services.astro";
import Fleet from "../components/Fleet.astro";
import Team from "../components/Team.astro";
import Pricing from "../components/Pricing.astro";
import Rental from "../components/Rental.astro";
import Portfolio from "../components/Portfolio.astro";
import CTA from "../components/CTA.astro";

import { Image } from "astro:assets";
import FAQ from "../components/FAQ.astro";

const logoFiles = import.meta.glob('../assets/logo/*.webp', { eager: true });
const getLogo = (name) => logoFiles[`../assets/logo/${name}.webp`]?.default;

const portfolioFiles = import.meta.glob('../assets/portfolio/*.{webp,avif,jpg,png}', { eager: true });
const getPortfolio = (path) => portfolioFiles[`../assets/${path}`]?.default;

const droneVideos = import.meta.glob('../assets/drone/*.webm', { eager: true });
const getDroneVideo = (name) => droneVideos[`../assets/drone/${name}.webm`]?.default;

import profilAfni from "../assets/profil/nur-afni.webp";
import profilHafiz from "../assets/profil/rahmat-hafiz.webp";

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <Fragment slot="head">
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                "name": "SKYGRAPH",
                "image": "https://skygraph.web.id/assets/skygraph-thumbnail.webp",
                "@id": "https://skygraph.web.id/",
                "alternateName": "Skygraph",
                "logo": "https://skygraph.web.id/assets/favicon.svg",
                "description": "Tingkatkan visual proyek Anda dengan layanan drone komersial premium dari SKYGRAPH di Pekanbaru, Riau. Kami menghadirkan videografi udara 4K sinematik, pemetaan lahan presisi, inspeksi aset cerdas, hingga dokumentasi event berkelas.",
                "url": "https://skygraph.web.id/",
                "telephone": "+6285365557009",
                "email": "skygraph.idn@gmail.com",
                "priceRange": "Mulai dari Rp600.000",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Pekanbaru",
                    "addressRegion": "Riau",
                    "addressCountry": "ID"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": "0.507068",
                    "longitude": "101.447779"
                },
                "areaServed": {
                    "@type": "State",
                    "name": "Riau",
                    "containedInPlace": {
                        "@type": "Country",
                        "name": "Indonesia"
                    }
                },
                "openingHoursSpecification": {
                    "@type": "OpeningHoursSpecification",
                    "dayOfWeek": [
                        "Monday",
                        "Tuesday",
                        "Wednesday",
                        "Thursday",
                        "Friday",
                        "Saturday"
                    ],
                    "opens": "08:00",
                    "closes": "18:00"
                },
                "sameAs": ["https://www.instagram.com/skygraph.idn/"],
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Layanan Drone Profesional",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Fotografi & Videografi Udara 4K",
                                "description": "Produksi visual cinematic 4K HDR untuk profil perusahaan, iklan, dan sosial media."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Dokumentasi Event & Wedding",
                                "description": "Liputan konser, festival, pernikahan, atau kegiatan massal outdoor secara dramatis dari udara."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Pemetaan & Topografi Drone",
                                "description": "Peta Orthomosaic, Topografi, Kontur, dan perhitungan volume Cut & Fill presisi tinggi."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Inspeksi Aset",
                                "description": "Pengecekan area sempit, atap pabrik, jembatan, tower, tanpa resiko keselamatan."
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Sewa Unit Drone",
                                "description": "Penyewaan armada drone tanpa pilot untuk kebutuhan personal atau harian."
                            }
                        }
                    ]
                }
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "Apakah saya perlu mengurus izin terbang (clearance)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Tidak perlu. Anda cukup terima beres. Segala perizinan operasional (SIDOPI, AirNav) akan kami tangani sepenuhnya sebelum eksekusi, terutama untuk penerbangan di area Red Zone atau objek vital."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana jika cuaca buruk pada hari eksekusi?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami menerapkan protokol Zero Accident. Jika cuaca ekstrem (hujan/angin kencang), pilot berhak menunda operasi demi keselamatan. Kami menjamin Reschedule tanpa biaya tambahan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah drone aman diterbangkan di dalam ruangan (Indoor)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Sangat aman. Untuk kebutuhan indoor, kami menggunakan armada spesifik (ringan, stabil, dan manuver gesit) atau armada khusus indoor lainnya sehingga terhindar dari risiko besar."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apa solusi jika drone terkendala teknis di tengah proyek?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami selalu mencegah downtime. Tim di lapangan diwajibkan selalu membawa Backup Unit (drone cadangan). Alur kerja proyek Anda tidak akan terhenti hanya karena kendala pada satu alat."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah data rahasia proyek perusahaan dijamin aman?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Terjamin 100%. Kami siap menandatangani kontrak NDA (Non-Disclosure Agreement). Seluruh data mentah (raw) akan dihapus secara permanen dari server kami segera setelah proyek selesai diserahterimakan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana jika proyek berada di luar kota Pekanbaru?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Sangat bisa. Biaya transportasi dan akomodasi tim akan ditambahkan secara transparan (at cost) ke dalam invoice, atau bisa diakomodasi langsung oleh pihak klien sesuai kesepakatan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Berapa lama estimasi proses pengerjaan (Delivery)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Estimasi sangat bergantung pada volume pekerjaan. Untuk editing video event biasanya memakan waktu 1-3 hari kerja. Sementara proses render pemetaan topografi/3D skala besar membutuhkan waktu 3-5 hari kerja."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Format hasil akhir apa yang akan saya terima?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Video & Foto: Format MP4/MOV beresolusi tinggi (hingga 4K) dan JPG/RAW. Data Geospasial: GeoTIFF (Orthomosaic, DEM), format DWG/DXF untuk kebutuhan AutoCAD, serta dokumen Laporan dalam bentuk PDF."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah ada batasan untuk revisi hasil editing?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami memberikan 2x kuota revisi minor secara gratis (seperti pergantian lagu pengiring atau pemotongan durasi). Untuk revisi mayor yang merubah struktur keseluruhan secara signifikan, akan dikenakan biaya tambahan ringan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana sistem pembayarannya?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Reguler: Pembayaran DP sebesar 50% untuk booking jadwal operasional, dan sisa 50% pelunasan diselesaikan sebelum penyerahan file master. Untuk paket korporat (B2B), sistem Term of Payment (TOP) dapat dinegosiasikan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah ada batasan durasi untuk sewa unit drone?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Minimal waktu penyewaan adalah 1 hari penuh (24 jam). Untuk masa penyewaan lebih dari 3 hari berturut-turut, kami secara otomatis akan memberikan potongan harga khusus (corporate rate)."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apa syarat utama untuk proses sewa unit drone?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Syarat utamanya sangat mudah: Penyewa wajib menitipkan 2 (dua) ID Card Asli (E-KTP & SIM/Paspor), menyertakan Deposit Tunai sebagai jaminan awal (akan dikembalikan 100% jika unit aman), serta menandatangani formulir kesepakatan sewa saat serah terima unit."
                        }
                    }
                ]
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Beranda",
                        "item": "https://skygraph.web.id/"
                    }
                ]
            }
        </script>
    </Fragment>
    <Hero />

    <Marquee />

    <About />

    <Features />

    <Services />

    <HowItWorks />

    <Fleet />

    <Team />

    <Pricing />

    <Rental />

    <Portfolio />

    <FAQ />

    <CTA />

    
</BaseLayout>

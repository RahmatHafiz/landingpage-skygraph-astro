    <script>
        document.addEventListener("astro:page-load", () => {
            const btnPrivacy = document.getElementById("btn-privacy");
            const btnTerms = document.getElementById("btn-terms");
            const activeBg = document.getElementById("active-bg");
            const flipContainer = document.getElementById("flip-container");

            if (btnPrivacy && btnTerms && activeBg && flipContainer) {
                function checkHash() {
                    if (window.location.hash === "#terms") {
                        switchToTerms();
                    } else {
                        switchToPrivacy();
                    }
                }

                // Check URL hash on load
                checkHash();

                // Intercept clicks on legal links to flip the card directly (since Astro intercepts hash changes via pushState)
                const privacyLinks = document.querySelectorAll(
                    'a[href="/legal#privacy"], a[href="#privacy"]',
                );
                const termsLinks = document.querySelectorAll(
                    'a[href="/legal#terms"], a[href="#terms"]',
                );

                privacyLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        switchToPrivacy();
                    });
                });

                termsLinks.forEach((link) => {
                    link.addEventListener("click", (e) => {
                        switchToTerms();
                    });
                });

                function switchToTerms() {
                    activeBg.style.transform = "translateX(100%)";
                    btnTerms.classList.remove("text-slate-500");
                    btnTerms.classList.add("text-white");
                    btnPrivacy.classList.remove("text-white");
                    btnPrivacy.classList.add("text-slate-500");
                    flipContainer.classList.add("active-flip");
                }

                function switchToPrivacy() {
                    activeBg.style.transform = "translateX(0)";
                    btnPrivacy.classList.remove("text-slate-500");
                    btnPrivacy.classList.add("text-white");
                    btnTerms.classList.remove("text-white");
                    btnTerms.classList.add("text-slate-500");
                    flipContainer.classList.remove("active-flip");
                }

                btnPrivacy.addEventListener("click", () => {
                    history.pushState(null, null, "#privacy");
                    switchToPrivacy();
                });

                btnTerms.addEventListener("click", () => {
                    history.pushState(null, null, "#terms");
                    switchToTerms();
                });
            }
        });
    </script>
</BaseLayout>

---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const { 
  title = "SKYGRAPH | Jasa Drone Profesional & Pemetaan Udara Pekanbaru, Riau", 
  description = "Layanan jasa drone komersial profesional di Pekanbaru, Riau. Spesialis pemetaan topografi, videografi udara 4K, inspeksi aset, dokumentasi wedding/event, dan sewa unit drone. Armada DJI Air 3S, Potensic Atom & FPV.",
  navStyle = "transparent"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <ClientRouter />

    <!-- Performance & Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://api.dicebear.com">

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

    <!-- SEO & Marketing Meta Tags -->
    <meta name="description" content={description}>
    <meta name="keywords" content="Jasa Drone Pekanbaru, Sewa Drone Pekanbaru, Pemetaan Drone Riau, Videografi Udara Pekanbaru, Inspeksi Drone Riau, Drone Wedding Pekanbaru, Potensic Atom, DJI Air 3S, Orthomosaic, Topografi Drone">
    <meta name="author" content="SKYGRAPH Aerial Solutions">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="theme-color" content="#0ea5e9">
    <link rel="canonical" href="https://skygraph.id/">
    <link rel="alternate" hreflang="id" href="https://skygraph.id/">

    <!-- GEO Tags for Local SEO (Pekanbaru, Riau) -->
    <meta name="geo.region" content="ID-RI">
    <meta name="geo.placename" content="Pekanbaru">
    <meta name="geo.position" content="0.507068;101.447779">
    <meta name="ICBM" content="0.507068, 101.447779">

    <!-- Open Graph for Social Media -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://skygraph.id/">
    <meta property="og:locale" content="id_ID">
    <meta property="og:site_name" content="SKYGRAPH Aerial Solutions">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <slot name="head" />

    <!-- Fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    </noscript>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3GVZQ3QRNY"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-3GVZQ3QRNY');
    </script>
</head>
<body class="font-sans text-slate-600 bg-slate-50 antialiased selection:bg-brand-500 selection:text-white flex flex-col min-h-screen overflow-x-hidden">

    <header>
        <nav class={`fixed w-full z-50 transition-all duration-300 border-b ${navStyle === 'solid' ? 'bg-slate-900 border-slate-800' : 'border-transparent'}`} id="navbar" data-navstyle={navStyle}>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16 md:h-20">
                    <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
                        <div class="w-8 h-8 md:w-10 md:h-10 group-hover:scale-105 transition-transform duration-300">
                            <img src="/assets/favicon.svg" alt="Skygraph Logo" class="w-full h-full drop-shadow-sm object-contain" />
                        </div>
                        <span
                            class="font-display font-black text-xl md:text-2xl tracking-[0.15em] text-white" id="brand-text">SKYGRAPH</span>
                    </a>

                    <div class="hidden xl:flex items-center space-x-6" id="nav-links">
                        <slot name="nav-links">
                            <!-- Default navigation links for index -->
                            <a href="/#layanan" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Layanan</a>
                            <a href="/#armada" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Armada</a>
                            <a href="/#tim" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Tim</a>
                            <a href="/#paket" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Paket & Sewa</a>
                            <a href="/#portofolio" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Portofolio</a>
                            <a href="/#faq" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">FAQ</a>
                            <a href="/#kontak" class="text-sm font-bold bg-brand-500 text-white px-5 py-2 rounded-xl hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/30 ml-2">Konsultasi Gratis</a>
                        </slot>
                    </div>

                    <div class="xl:hidden flex items-center">
                        <button id="mobile-menu-btn" onclick="toggleMenu()" class="text-white hover:text-brand-500 focus:outline-none transition-colors" aria-label="Buka menu navigasi">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div id="mobile-menu" class="xl:hidden hidden bg-slate-900 border-b border-slate-800 shadow-xl">
                <div class="px-2 pt-2 pb-4 space-y-1 sm:px-3">
                    <slot name="mobile-nav-links">
                        <!-- Default mobile navigation links for index -->
                        <a href="/#layanan" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Layanan</a>
                        <a href="/#armada" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Armada</a>
                        <a href="/#tim" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Tim</a>
                        <a href="/#paket" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Paket & Sewa</a>
                        <a href="/#portofolio" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Portofolio</a>
                        <a href="/#faq" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">FAQ</a>
                        <a href="/#kontak" class="mobile-link block mt-4 px-3 py-2 text-center rounded-lg text-base font-bold bg-brand-500 text-white hover:bg-brand-600">Konsultasi Gratis</a>
                    </slot>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow">
        <slot />
    </main>

    <footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-8 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
                <div class="lg:col-span-1">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8">
                            <img src="/assets/favicon.svg" alt="Skygraph Logo" class="w-full h-full object-contain" />
                        </div>
                        <span class="font-display font-black text-xl tracking-[0.15em] text-white">SKYGRAPH</span>
                    </div>
                    <p class="text-sm text-slate-300 mb-6 leading-relaxed pr-4">
                        Menghadirkan solusi visual udara dan akuisisi data presisi tinggi secara efisien untuk bisnis Anda.
                    </p>
                    <div class="flex space-x-4">
                        <!-- Instagram -->
                        <a href="https://instagram.com/skygraph.id" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                            class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-brand-500 hover:text-white transition-all duration-300">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                        </a>
                        <!-- Threads / At Symbol -->
                        <a href="https://threads.net/@skygraph.id" target="_blank" rel="noopener noreferrer" aria-label="Threads"
                            class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-brand-500 hover:text-white transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                            </svg>
                        </a>
                        <!-- Email -->
                        <a href="mailto:halo@skygraph.id" aria-label="Email"
                            class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-brand-500 hover:text-white transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-1">
                    <h4 class="text-white font-bold mb-4">Layanan Inti</h4>
                    <ul class="space-y-3 text-sm text-slate-300">
                        <li><a href="/#layanan" class="hover:text-brand-500 transition-colors">Fotografi / Videografi</a></li>
                        <li><a href="/#layanan" class="hover:text-brand-500 transition-colors">Event & Wedding</a></li>
                        <li><a href="/#layanan" class="hover:text-brand-500 transition-colors">Pemetaan & Inspeksi</a></li>
                        <li><a href="/#layanan" class="hover:text-brand-500 transition-colors">Monitoring Konstruksi</a></li>
                    </ul>
                </div>

                <div class="lg:col-span-1">
                    <h4 class="text-white font-bold mb-4">Informasi</h4>
                    <ul class="space-y-3 text-sm text-slate-300">
                        <li><a href="/#armada" class="hover:text-brand-500 transition-colors">Armada Udara</a></li>
                        <li><a href="/#paket" class="hover:text-brand-500 transition-colors">Paket Penggunaan</a></li>
                        <li><a href="/#sewa" class="hover:text-brand-500 transition-colors">Sewa Unit Drone</a></li>
                        <li><a href="/#faq" class="hover:text-brand-500 transition-colors">Pusat Bantuan (FAQ)</a></li>
                    </ul>
                </div>

                <div class="lg:col-span-1">
                    <h4 class="text-white font-bold mb-4">Butuh Bantuan?</h4>
                    <p class="text-sm text-slate-300 mb-4">Tim lapangan kami siap mengeksekusi proyek Anda.</p>
                    <a href="/#kontak"
                        class="inline-block w-full text-center py-3 rounded-xl bg-brand-500 text-white font-bold hover:bg-brand-600 shadow-lg shadow-brand-500/20 transition-all duration-300">
                        Hubungi Sekarang
                    </a>
                </div>
            </div>

            <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-slate-400">
                <p>&copy; <span id="year"></span> Skygraph Aerial Solutions Pekanbaru. Hak Cipta Dilindungi.</p>
                <div class="flex gap-4">
                    <a href="/legal#privacy" class="hover:text-white transition-colors">Kebijakan Privasi</a>
                    <a href="/legal#terms" class="hover:text-white transition-colors">Syarat & Ketentuan</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Chatbot UI -->
    <div class="fixed bottom-0 right-0 p-4 sm:p-6 z-[60] flex flex-col items-end gap-3 pointer-events-none">
        <div id="chatbot-ui"
            class="hidden-chat bg-white rounded-2xl shadow-2xl border border-slate-200 w-72 pointer-events-auto flex flex-col overflow-hidden">
            <div class="bg-slate-900 p-4 text-white flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 flex items-center justify-center">
                        <img src="/assets/favicon.svg" alt="Admin Logo" class="w-full h-full drop-shadow-sm object-contain" />
                    </div>
                    <div>
                        <h5 class="font-bold text-sm leading-tight">Skygraph Admin</h5>
                        <p class="text-[10px] text-brand-400">Online</p>
                    </div>
                </div>
                <button onclick="toggleChat()" aria-label="Tutup Obrolan Chatbot"
                    class="text-slate-400 hover:text-white">
                    <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <div class="p-4 bg-slate-50 h-32 overflow-y-auto text-sm text-slate-600 flex flex-col gap-2">
                <div
                    class="bg-white border border-slate-200 p-2.5 rounded-xl rounded-tl-none self-start max-w-[85%] text-xs shadow-sm">
                    Silakan ketik pertanyaan Anda atau jelaskan kebutuhan proyek Anda di sini. Pesan akan langsung
                    diteruskan ke WhatsApp representatif kami.
                </div>
            </div>
            <div class="p-3 bg-white border-t border-slate-200 flex gap-2 items-center">
                <input type="text" id="chat-input" aria-label="Ketik pesan WhatsApp" placeholder="Ketik pesan..."
                    class="w-full text-sm outline-none px-3 py-2 bg-slate-50 border border-slate-200 rounded-full focus:border-brand-500"
                    onkeypress="handleChatSubmit(event)">
                <button onclick="sendChat()" aria-label="Kirim Pesan Chatbot"
                    class="bg-brand-500 hover:bg-brand-600 text-white w-9 h-9 rounded-full flex items-center justify-center shrink-0 transition-colors shadow-md">
                    <svg aria-hidden="true" class="w-4 h-4 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
                    </svg>
                </button>
            </div>
        </div>

        <button id="wa-btn" onclick="toggleChat()" aria-label="Buka Chatbot WhatsApp"
            class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg shadow-green-500/30 hover:scale-110 transition-transform pointer-events-auto relative transform translate-y-20 opacity-0 duration-500">
            <svg aria-hidden="true" class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path
                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
        </button>
    </div>

    <!-- Include main scripts -->
    <script src="../scripts/main.js"></script>
</body>
</html>

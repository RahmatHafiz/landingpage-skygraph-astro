---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const {
    title = "SKYGRAPH | Jasa Drone Profesional, Videografi & Sewa Drone Pekanbaru, Riau",
    description = "Layanan jasa drone komersial profesional di Pekanbaru, Riau. Spesialis videografi udara 4K, inspeksi aset, dokumentasi event/wedding, sewa unit drone, dan pemetaan (mapping).",
    navStyle = "transparent",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
        />
        <ClientRouter />

        <!-- Performance & Preconnects -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preconnect" href="https://api.dicebear.com" />

        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
        <link rel="apple-touch-icon" href="/assets/favicon.svg" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- SEO & Marketing Meta Tags -->
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="Jasa Drone Pekanbaru, Sewa Drone Pekanbaru, Videografi Udara Riau, Drone Wedding Pekanbaru, Inspeksi Aset Drone, Pemetaan Drone Riau, DJI Air 3S, DJI Mini 5 Pro, DJI Avata 360, DJI Neo 2, Potensic Atom"
        />
        <meta name="author" content="SKYGRAPH" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta name="theme-color" content="#0ea5e9" />
        <link rel="canonical" href="https://skygraph.web.id/" />
        <link rel="alternate" hreflang="id" href="https://skygraph.web.id/" />

        <!-- GEO Tags for Local SEO (Pekanbaru, Riau) -->
        <meta name="geo.region" content="ID-RI" />
        <meta name="geo.placename" content="Pekanbaru" />
        <meta name="geo.position" content="0.507068;101.447779" />
        <meta name="ICBM" content="0.507068, 101.447779" />

        <!-- Open Graph for Social Media -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://skygraph.web.id/" />
        <meta property="og:locale" content="id_ID" />
        <meta property="og:site_name" content="SKYGRAPH" />
        <meta
            property="og:image"
            content="https://skygraph.web.id/assets/hero-bg.webp"
        />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content="https://skygraph.web.id/assets/hero-bg.webp"
        />

        <!-- Structured Data for SEO, AEO, and GEO -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ProfessionalService",
                "name": "SKYGRAPH",
                "image": "https://skygraph.web.id/assets/favicon.svg",
                "description": "Layanan jasa drone komersial profesional di Pekanbaru, Riau. Spesialis videografi udara 4K, inspeksi aset, dokumentasi event/wedding, sewa unit drone, dan pemetaan (mapping).",
                "url": "https://skygraph.web.id/",
                "telephone": "+6285365557009",
                "email": "skygraph.idn@gmail.com",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Pekanbaru",
                    "addressRegion": "Riau",
                    "addressCountry": "ID"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": "0.507068",
                    "longitude": "101.447779"
                },
                "areaServed": "Pekanbaru, Riau",
                "priceRange": "$$"
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "SKYGRAPH",
                "url": "https://skygraph.web.id/",
                "description": "Layanan jasa drone profesional, videografi & sewa drone di Pekanbaru, Riau.",
                "publisher": {
                    "@type": "Organization",
                    "name": "SKYGRAPH",
                    "logo": {
                        "@type": "ImageObject",
                        "url": "https://skygraph.web.id/assets/favicon.svg"
                    }
                }
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "Apakah saya perlu mengurus izin terbang (clearance)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Tidak perlu. Anda cukup terima beres. Segala perizinan operasional (SIDOPI, AirNav) akan kami tangani sepenuhnya sebelum eksekusi, terutama untuk penerbangan di area Red Zone atau objek vital."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Bagaimana jika cuaca buruk pada hari eksekusi?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Kami menerapkan protokol Zero Accident. Jika cuaca ekstrem (hujan/angin kencang), pilot berhak menunda operasi demi keselamatan. Kami menjamin Reschedule tanpa biaya tambahan."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Apakah drone aman diterbangkan di dalam ruangan (Indoor)?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Sangat aman. Untuk kebutuhan indoor, kami menggunakan armada spesifik (ringan, stabil, dan manuver gesit) atau armada khusus indoor lainnya sehingga terhindar dari risiko besar."
                        }
                    }
                ]
            }
        </script>

        <slot name="head" />

        <!-- Fonts -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap"
                rel="stylesheet"
            />
        </noscript>
    </head>
    <body
        class="font-sans text-slate-600 bg-slate-50 antialiased selection:bg-brand-500 selection:text-white flex flex-col min-h-screen overflow-x-hidden"
    >
        <header>
            <nav
                class={`fixed w-full z-50 transition-colors duration-300 border-b ${navStyle === "solid" ? "bg-slate-900 border-slate-800" : "border-transparent"}`}
                id="navbar"
                data-navstyle={navStyle}
            >
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-center h-16 md:h-20">
                        <a
                            href="/"
                            class="flex-shrink-0 flex items-center gap-3 group"
                        >
                            <div
                                class="w-8 h-8 md:w-10 md:h-10 group-hover:scale-105 transition-transform duration-300"
                            >
                                <img
                                    src="/assets/favicon.svg"
                                    alt="Logo SKYGRAPH"
                                    class="w-full h-full drop-shadow-sm object-contain"
                                />
                            </div>
                            <span
                                class="font-display font-black text-xl md:text-2xl tracking-[0.15em] text-white"
                                id="brand-text">SKYGRAPH</span
                            >
                        </a>

                        <div
                            class="hidden xl:flex items-center space-x-6"
                            id="nav-links"
                        >
                            <slot name="nav-links">
                                <!-- Default navigation links for index -->
                                <a
                                    href="/#layanan"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >Layanan</a
                                >
                                <a
                                    href="/#armada"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >Armada</a
                                >
                                <a
                                    href="/#tim"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >Tim</a
                                >
                                <a
                                    href="/#paket"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >Paket & Sewa</a
                                >
                                <a
                                    href="/#portofolio"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >Portofolio</a
                                >
                                <a
                                    href="/#faq"
                                    class="text-sm font-semibold text-slate-300 hover:text-white transition-colors"
                                    >FAQ</a
                                >
                                <a
                                    href="/#kontak"
                                    class="text-sm font-bold bg-brand-500 text-white px-5 py-2 rounded-xl hover:bg-brand-600 transition-colors shadow-lg shadow-brand-500/30 ml-2"
                                    >Konsultasi Gratis</a
                                >
                            </slot>
                        </div>

                        <div class="xl:hidden flex items-center">
                            <button type="button"
                                id="mobile-menu-btn"
                                onclick="toggleMenu()"
                                class="text-slate-300 hover:text-white focus:outline-none p-2 rounded-lg hover:text-brand-400 bg-transparent border border-transparent hover:bg-white/10 transition-colors"
                                aria-label="Buka menu navigasi"
                                aria-expanded="false"
                                aria-controls="mobile-menu"
                            >
                                <svg
                                    aria-hidden="true"
                                    class="h-6 w-6"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        id="menu-icon"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M4 6h16M4 12h16M4 18h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile Menu -->
                <div
                    id="mobile-menu"
                    class="absolute top-16 md:top-20 left-0 w-full bg-slate-900/95 backdrop-blur-xl shadow-xl xl:hidden hidden border-t border-slate-800 transition-all"
                >
                    <div class="flex flex-col px-6 py-6 space-y-4">
                        <slot name="mobile-nav-links">
                            <!-- Default mobile navigation links for index -->
                            <a
                                href="/#layanan"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Layanan Jasa</a
                            >
                            <a
                                href="/#armada"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Armada Drone</a
                            >
                            <a
                                href="/#tim"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Tim Pilot</a
                            >
                            <a
                                href="/#paket"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Paket Harga</a
                            >
                            <a
                                href="/#portofolio"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Portofolio</a
                            >
                            <a
                                href="/#faq"
                                class="mobile-link text-base font-semibold text-slate-300 hover:text-white"
                                >Tanya Jawab (FAQ)</a
                            >
                            <div class="pt-4 border-t border-slate-800">
                                <a
                                    href="/#kontak"
                                    class="mobile-link flex items-center justify-center w-full px-6 py-3 rounded-xl bg-brand-500 text-white font-bold shadow-lg hover:bg-brand-600 transition-colors"
                                    >Konsultasi Gratis</a
                                >
                            </div>
                        </slot>
                    </div>
                </div>
            </nav>
        </header>

        <main class="flex-grow">
            <slot />
        </main>

        <footer
            class="bg-slate-900 border-t border-slate-800 pt-16 pb-8 relative overflow-hidden"
        >
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"
            >
            </div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12"
                >
                    <div class="lg:col-span-1">
                        <a
                            href="/"
                            class="flex items-center gap-3 mb-6 hover:opacity-80 transition-opacity w-fit cursor-pointer"
                        >
                            <div class="w-8 h-8">
                                <img
                                    src="/assets/favicon.svg"
                                    alt="Logo SKYGRAPH"
                                    class="w-full h-full object-contain"
                                />
                            </div>
                            <span
                                class="font-display font-black text-xl tracking-[0.15em] text-white"
                                >SKYGRAPH</span
                            >
                        </a>
                        <p
                            class="text-sm text-slate-300 mb-6 leading-relaxed pr-4"
                        >
                            Menghadirkan solusi visual udara dan akuisisi data
                            presisi tinggi secara efisien untuk bisnis Anda.
                        </p>
                        <div class="flex space-x-4">
                            <!-- Instagram -->
                            <a
                                href="https://www.instagram.com/skygraph.idn/"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Instagram"
                                class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400 hover:bg-gradient-to-tr hover:from-yellow-400 hover:via-pink-500 hover:to-purple-600 hover:text-white transition-all duration-300 shadow-sm"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                                    ></path>
                                </svg>
                            </a>
                            <!-- Threads -->
                            <a
                                href="https://www.threads.net/@skygraph.idn"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Threads"
                                class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-400 hover:bg-black hover:text-white transition-all duration-300 shadow-sm"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="currentColor"
                                    viewBox="0 0 192 192"
                                >
                                    <path
                                        d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.194473 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"
                                    ></path>
                                </svg>
                            </a>
                            <!-- Email -->
                            <a
                                href="mailto:skygraph.idn@gmail.com"
                                aria-label="Email"
                                class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-brand-500 hover:text-white transition-all duration-300"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </a>
                        </div>
                    </div>

                    <div class="lg:col-span-1">
                        <h4 class="text-white font-bold mb-4">Layanan Inti</h4>
                        <ul class="space-y-3 text-sm text-slate-300">
                            <li>
                                <a
                                    href="/#layanan"
                                    class="hover:text-brand-500 transition-colors"
                                    >Fotografi / Videografi</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#layanan"
                                    class="hover:text-brand-500 transition-colors"
                                    >Event & Wedding</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#layanan"
                                    class="hover:text-brand-500 transition-colors"
                                    >Promosi & Konten</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#layanan"
                                    class="hover:text-brand-500 transition-colors"
                                    >Monitoring & Surveilans</a
                                >
                            </li>
                        </ul>
                    </div>

                    <div class="lg:col-span-1">
                        <h4 class="text-white font-bold mb-4">Informasi</h4>
                        <ul class="space-y-3 text-sm text-slate-300">
                            <li>
                                <a
                                    href="/#armada"
                                    class="hover:text-brand-500 transition-colors"
                                    >Armada Drone</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#paket"
                                    class="hover:text-brand-500 transition-colors"
                                    >Paket Penggunaan</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#sewa"
                                    class="hover:text-brand-500 transition-colors"
                                    >Sewa Unit Drone</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/#faq"
                                    class="hover:text-brand-500 transition-colors"
                                    >Pusat Bantuan (FAQ)</a
                                >
                            </li>
                        </ul>
                    </div>

                    <div class="lg:col-span-1">
                        <h4 class="text-white font-bold mb-4">
                            Butuh Bantuan?
                        </h4>
                        <p class="text-sm text-slate-300 mb-4">
                            Tim lapangan kami siap mengeksekusi proyek Anda.
                        </p>
                        <a
                            href="https://wa.me/6285365557009?text=Halo%20SKYGRAPH%2C%20saya%20butuh%20bantuan%20dan%20ingin%20berkonsultasi%20mengenai%20proyek%20saya.%20Bisa%20berikan%20informasi%20lebih%20lanjut%3F"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-block w-full text-center py-3 rounded-xl bg-brand-500 text-white font-bold hover:bg-brand-600 shadow-lg shadow-brand-500/20 transition-all duration-300"
                        >
                            Hubungi Sekarang
                        </a>
                    </div>
                </div>

                <div
                    class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-slate-400"
                >
                    <p>
                        &copy; <span id="year"></span> SKYGRAPH. All rights reserved.
                    </p>
                    <div class="flex gap-4">
                        <a
                            href="/legal#privacy"
                            class="hover:text-white transition-colors"
                            >Kebijakan Privasi</a
                        >
                        <a
                            href="/legal#terms"
                            class="hover:text-white transition-colors"
                            >Syarat & Ketentuan</a
                        >
                    </div>
                </div>
            </div>
        </footer>

        <!-- Chatbot UI -->
        <div
            id="floating-widgets"
            class="fixed bottom-0 right-0 p-4 sm:p-6 z-[60] flex flex-col items-end gap-3 pointer-events-none"
        >
            <div
                id="chatbot-ui"
                class="hidden-chat bg-white rounded-2xl shadow-2xl border border-slate-200 w-72 pointer-events-auto flex flex-col overflow-hidden"
            >
                <div
                    class="bg-slate-900 p-4 text-white flex justify-between items-center"
                >
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 flex items-center justify-center">
                            <img
                                src="/assets/favicon.svg"
                                alt="Admin SKYGRAPH"
                                class="w-full h-full drop-shadow-sm object-contain"
                            />
                        </div>
                        <div>
                            <h5 class="font-bold text-sm leading-tight">
                                Admin SKYGRAPH
                            </h5>
                            <p class="text-[10px] text-brand-400">Online</p>
                        </div>
                    </div>
                    <button type="button"
                        onclick="toggleChat()"
                        aria-label="Tutup Obrolan Chatbot"
                        class="text-slate-400 hover:text-white"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M6 18L18 6M6 6l12 12"
                            >
                            </path>
                        </svg>
                    </button>
                </div>
                <div
                    class="p-4 bg-slate-50 h-32 overflow-y-auto text-sm text-slate-600 flex flex-col gap-2"
                >
                    <div
                        class="bg-white border border-slate-200 p-2.5 rounded-xl rounded-tl-none self-start max-w-[85%] text-xs shadow-sm"
                    >
                        Silakan ketik pertanyaan Anda atau jelaskan kebutuhan
                        proyek Anda di sini. Pesan akan langsung diteruskan ke
                        WhatsApp representatif kami.
                    </div>
                </div>
                <div
                    class="p-3 bg-white border-t border-slate-200 flex gap-2 items-center"
                >
                    <input
                        type="text"
                        id="chat-input"
                        aria-label="Ketik pesan WhatsApp"
                        placeholder="Ketik pesan..."
                        class="w-full text-sm outline-none px-3 py-2 bg-slate-50 border border-slate-200 rounded-full focus:border-brand-500"
                        onkeypress="handleChatSubmit(event)"
                    />
                    <button type="button"
                        onclick="sendChat()"
                        aria-label="Kirim Pesan Chatbot"
                        class="bg-brand-500 hover:bg-brand-600 text-white w-9 h-9 rounded-full flex items-center justify-center shrink-0 transition-colors shadow-md"
                    >
                        <svg
                            aria-hidden="true"
                            class="w-4 h-4 translate-x-0.5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                            ></path>
                        </svg>
                    </button>
                </div>
            </div>

            <button type="button"
                id="wa-btn"
                onclick="toggleChat()"
                aria-label="Buka Chatbot WhatsApp"
                class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg shadow-green-500/30 hover:scale-110 transition-transform pointer-events-auto relative transform translate-y-20 opacity-0 duration-500"
            >
                <svg
                    aria-hidden="true"
                    class="w-7 h-7 text-white"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                    ></path>
                </svg>
            </button>

            <!-- Scroll Up Button -->
            <button type="button"
                id="scroll-up-btn"
                onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
                aria-label="Kembali ke atas"
                class="group w-10 h-10 bg-white/90 backdrop-blur-md border border-slate-200 text-slate-500 rounded-full flex items-center justify-center shadow-md hover:shadow-xl hover:bg-brand-500 hover:text-white hover:border-brand-500 hover:scale-110 hover:-translate-y-1 transition-all duration-500 pointer-events-auto relative transform translate-y-20 opacity-0"
            >
                <svg
                    class="w-4 h-4 group-hover:animate-bounce"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
                </svg>
            </button>
        </div>

        <!-- Include main scripts -->
        <script src="../scripts/main.js"></script>
    </body>
</html>
